{
  "openapi": "3.1.0",
  "info": {
    "title": "Backend API",
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/admin/ping": {
      "get": {
        "operationId": "adminPing",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "authMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/home/dashboard": {
      "get": {
        "operationId": "getHomeDashboard",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeDashboardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/home/today-moment": {
      "put": {
        "operationId": "putTodayMoment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HomeTodayMomentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeTodayMomentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/home/mood": {
      "put": {
        "operationId": "putMood",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HomeMoodRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeMoodSummaryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/home/today-moment/{momentId}/reaction": {
      "post": {
        "operationId": "reactToTodayMoment",
        "parameters": [
          {
            "name": "momentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HomeMomentReactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeTodayMomentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tether/me": {
      "get": {
        "operationId": "tetherMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TetherStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tether/invitations": {
      "post": {
        "operationId": "createTetherInvitation",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TetherInvitationResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/tether/accept": {
      "post": {
        "operationId": "acceptTether",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TetherAcceptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TetherStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "operationId": "updateCurrentUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HomeDashboardResponse": {
        "type": "object",
        "required": ["tether", "latestBub", "mood"],
        "properties": {
          "tether": {
            "$ref": "#/components/schemas/HomeTetherCardResponse"
          },
          "todayMoment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HomeTodayMomentResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "latestBub": {
            "$ref": "#/components/schemas/HomeLatestBubResponse"
          },
          "mood": {
            "$ref": "#/components/schemas/HomeMoodSummaryResponse"
          }
        }
      },
      "HomeLatestBubResponse": {
        "type": "object",
        "required": ["hasActivity", "copy"],
        "properties": {
          "hasActivity": {
            "type": "boolean"
          },
          "copy": {
            "type": "string"
          },
          "occurredAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "HomeMomentReactionRequest": {
        "type": "object",
        "required": ["reaction"],
        "properties": {
          "reaction": {
            "type": "string"
          }
        }
      },
      "HomeMoodRequest": {
        "type": "object",
        "required": ["mood"],
        "properties": {
          "mood": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1
          }
        }
      },
      "HomeMoodSummaryResponse": {
        "type": "object",
        "required": ["copy"],
        "properties": {
          "copy": {
            "type": "string"
          },
          "mood": {
            "type": ["string", "null"],
            "maxLength": 20
          }
        }
      },
      "HomeTetherCardResponse": {
        "type": "object",
        "required": ["hasActiveTether"],
        "properties": {
          "hasActiveTether": {
            "type": "boolean"
          },
          "partnerUserId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "partnerDisplayName": {
            "type": ["string", "null"]
          },
          "partnerProfileImageUrl": {
            "type": ["string", "null"]
          },
          "viewerProfileImageUrl": {
            "type": ["string", "null"]
          },
          "tetheredSince": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "ctaLabel": {
            "type": ["string", "null"]
          }
        }
      },
      "HomeTodayMomentRequest": {
        "type": "object",
        "required": ["photoUrl", "localDate"],
        "properties": {
          "photoUrl": {
            "type": "string"
          },
          "localDate": {
            "type": "string"
          }
        }
      },
      "HomeTodayMomentResponse": {
        "type": "object",
        "required": ["momentId", "photoUrl", "localDate", "viewerHasPostedToday"],
        "properties": {
          "momentId": {
            "type": "string",
            "format": "uuid"
          },
          "photoUrl": {
            "type": "string"
          },
          "localDate": {
            "type": "string"
          },
          "viewerHasPostedToday": {
            "type": "boolean"
          },
          "partnerReaction": {
            "type": ["string", "null"]
          }
        }
      },
      "KycStatus": {
        "type": "string",
        "enum": ["NONE", "PENDING", "VERIFIED", "REJECTED"]
      },
      "Role": {
        "type": "string",
        "enum": ["USER", "ADMIN"]
      },
      "TetherAcceptRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^BUB-[A-Z0-9]{4}-[A-Z0-9]{4}$"
          }
        }
      },
      "TetherInvitationResponse": {
        "type": "object",
        "required": ["id", "code", "expiresAt", "qrPayload"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "qrPayload": {
            "type": "string"
          }
        }
      },
      "TetherStatusResponse": {
        "type": "object",
        "required": ["hasActiveTether"],
        "properties": {
          "hasActiveTether": {
            "type": "boolean"
          },
          "partnerUserId": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["id", "email", "role", "userType", "kycStatus", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": ["string", "null"]
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "userType": {
            "$ref": "#/components/schemas/UserType"
          },
          "kycStatus": {
            "$ref": "#/components/schemas/KycStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserType": {
        "type": "string",
        "enum": ["INDIVIDUAL", "ORGANIZATION"]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": ["string", "null"],
            "format": "email"
          },
          "displayName": {
            "type": ["string", "null"],
            "maxLength": 120
          }
        }
      }
    }
  }
}
