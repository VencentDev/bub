        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "senderUserId": {
            "type": "string",
            "format": "uuid"
          },
          "snippet": {
            "type": "string"
          },
          "deletedForEveryone": {
            "type": "boolean"
          }
        }
      },
      "ChatReactionRequest": {
        "type": "object",
        "properties": {
          "reaction": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["reaction"]
      },
      "ChatPartnerNicknameRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          }
        }
      },
      "BubSendResponse": {
        "type": "object",
        "properties": {
          "bubId": {
            "type": "string",
            "format": "uuid"
          },
          "tetherConnectionId": {
            "type": "string",
            "format": "uuid"
          },
          "senderUserId": {
            "type": "string",
            "format": "uuid"
          },
          "receiverUserId": {
            "type": "string",
            "format": "uuid"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JsonNullableString": {
        "type": "object",
        "properties": {
          "present": {
            "type": "boolean"
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/JsonNullableString"
          },
          "displayName": {
            "$ref": "#/components/schemas/JsonNullableString"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["USER", "ADMIN"]
