  "components": {
    "schemas": {
      "HomeTodayMomentRequest": {
        "type": "object",
        "properties": {
          "photoUrl": { "type": "string", "minLength": 1 },
          "localDate": { "type": "string", "format": "date" }
        },
        "required": ["localDate", "photoUrl"]
      },
      "HomeTodayMomentResponse": {
        "type": "object",
        "properties": {
          "momentId": { "type": "string", "format": "uuid" },
          "photoUrl": { "type": "string" },
          "localDate": { "type": "string", "format": "date" },
          "viewerHasPostedToday": { "type": "boolean" },
          "partnerReaction": { "type": "string" }
        }
      },
      "HomeMoodRequest": {
        "type": "object",
        "properties": { "mood": { "type": "string", "maxLength": 20, "minLength": 0 } },
        "required": ["mood"]
      },
      "HomeMoodSummaryResponse": {
        "type": "object",
        "properties": { "copy": { "type": "string" }, "mood": { "type": "string" } }
      },
      "TetherInvitationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "qrPayload": { "type": "string" }
        }
      },
      "TetherAcceptRequest": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "pattern": "^BUB-[A-Z0-9]{4}-[A-Z0-9]{4}$" }
        },
        "required": ["code"]
      },
      "TetherStatusResponse": {
        "type": "object",
        "properties": {
          "hasActiveTether": { "type": "boolean" },
          "partnerUserId": { "type": "string", "format": "uuid" }
        }
      },
      "HomeMomentReactionRequest": {
        "type": "object",
        "properties": { "reaction": { "type": "string", "minLength": 1 } },
        "required": ["reaction"]
      },
      "ChatTypingRequest": { "type": "object", "properties": { "typing": { "type": "boolean" } } },
      "ChatPresenceResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ONLINE", "OFFLINE"] },
          "lastSeenAt": { "type": "string", "format": "date-time" }
        }
      },
      "ChatStateResponse": {
        "type": "object",
        "properties": {
          "partnerTyping": { "type": "boolean" },
          "partnerPresence": { "$ref": "#/components/schemas/ChatPresenceResponse" }
        }
      },
      "ChatReadRequest": {
        "type": "object",
        "properties": { "upToMessageId": { "type": "string", "format": "uuid" } },
        "required": ["upToMessageId"]
      },
      "ChatSendMessageRequest": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["TEXT", "EMOJI", "GIF"] },
          "body": { "type": "string" },
          "gifUrl": { "type": "string" },
          "gifProviderId": { "type": "string" },
          "replyToMessageId": { "type": "string", "format": "uuid" }
        },
        "required": ["type"]
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "senderUserId": { "type": "string", "format": "uuid" },
          "viewerMessage": { "type": "boolean" },
          "type": { "type": "string", "enum": ["TEXT", "EMOJI", "GIF"] },
          "body": { "type": "string" },
          "gifUrl": { "type": "string" },
          "gifProviderId": { "type": "string" },
          "reply": { "$ref": "#/components/schemas/ChatReplyPreviewResponse" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "editedAt": { "type": "string", "format": "date-time" },
          "deletedForEveryone": { "type": "boolean" },
          "deliveryState": { "type": "string", "enum": ["DELIVERED", "SEEN"] },
          "editable": { "type": "boolean" },
          "deletableForEveryone": { "type": "boolean" },
          "viewerReaction": { "type": "string" },
          "reactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatReactionSummaryResponse" }
          }
        }
      },
      "ChatReactionSummaryResponse": {
        "type": "object",
        "properties": {
          "reaction": { "type": "string" },
          "count": { "type": "integer", "format": "int32" }
        }
      },
      "ChatReplyPreviewResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "senderUserId": { "type": "string", "format": "uuid" },
          "snippet": { "type": "string" },
          "deletedForEveryone": { "type": "boolean" }
        }
      },
      "ChatReactionRequest": {
        "type": "object",
        "properties": { "reaction": { "type": "string", "minLength": 1 } },
        "required": ["reaction"]
      },
      "JsonNullableString": {
        "type": "object",
        "properties": { "present": { "type": "boolean" } }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "email": { "$ref": "#/components/schemas/JsonNullableString" },
          "displayName": { "$ref": "#/components/schemas/JsonNullableString" }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] },
          "userType": { "type": "string", "enum": ["INDIVIDUAL", "ORGANIZATION"] },
          "kycStatus": { "type": "string", "enum": ["NONE", "PENDING", "VERIFIED", "REJECTED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ChatEditMessageRequest": {
        "type": "object",
        "properties": { "body": { "type": "string", "maxLength": 4000, "minLength": 0 } },
        "required": ["body"]
      },
      "HomeDashboardResponse": {
        "type": "object",
        "properties": {
          "tether": { "$ref": "#/components/schemas/HomeTetherCardResponse" },
          "todayMoment": { "$ref": "#/components/schemas/HomeTodayMomentResponse" },
          "latestBub": { "$ref": "#/components/schemas/HomeLatestBubResponse" },
          "mood": { "$ref": "#/components/schemas/HomeMoodSummaryResponse" }
        }
      },
      "HomeLatestBubResponse": {
        "type": "object",
        "properties": {
          "hasActivity": { "type": "boolean" },
          "copy": { "type": "string" },
          "occurredAt": { "type": "string", "format": "date-time" }
        }
      },
      "HomeTetherCardResponse": {
        "type": "object",
        "properties": {
          "hasActiveTether": { "type": "boolean" },
          "partnerUserId": { "type": "string", "format": "uuid" },
          "partnerDisplayName": { "type": "string" },
          "partnerProfileImageUrl": { "type": "string" },
          "viewerProfileImageUrl": { "type": "string" },
          "tetheredSince": { "type": "string", "format": "date-time" },
          "ctaLabel": { "type": "string" }
        }
      },
      "ChatThreadResponse": {
        "type": "object",
        "properties": {
          "hasActiveTether": { "type": "boolean" },
          "tetherConnectionId": { "type": "string", "format": "uuid" },
          "partnerDisplayName": { "type": "string" },
          "state": { "$ref": "#/components/schemas/ChatStateResponse" },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessageResponse" }
          }
        }
      }
    },
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } }
  }
}
