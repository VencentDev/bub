  "components": {
    "schemas": {
      "HomeTodayMomentRequest": {
        "type": "object",
        "properties": {
          "photoUrl": {
            "type": "string",
            "minLength": 1
          },
          "localDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": ["localDate", "photoUrl"]
      },
      "HomeTodayMomentResponse": {
        "type": "object",
        "properties": {
          "momentId": {
            "type": "string",
            "format": "uuid"
          },
          "photoUrl": {
            "type": "string"
          },
          "viewerPhotoUrl": {
            "type": "string"
          },
          "partnerCapturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "viewerHasPostedToday": {
            "type": "boolean"
          },
          "partnerReaction": {
            "type": "string"
          }
        }
      },
      "HomeMoodRequest": {
        "type": "object",
        "properties": {
          "mood": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          }
        },
        "required": ["mood"]
      },
      "HomeMoodSummaryResponse": {
        "type": "object",
        "properties": {
          "copy": {
            "type": "string"
          },
          "mood": {
            "type": "string"
          }
        }
      },
      "TetherInvitationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "qrPayload": {
            "type": "string"
          }
        }
      },
      "TetherAcceptRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^BUB-[A-Z0-9]{4}-[A-Z0-9]{4}$"
          }
        },
        "required": ["code"]
      },
      "TetherStatusResponse": {
        "type": "object",
        "properties": {
          "hasActiveTether": {
            "type": "boolean"
          },
          "partnerUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HomeMomentReactionRequest": {
        "type": "object",
        "properties": {
          "reaction": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["reaction"]
      },
      "ChatTypingRequest": {
        "type": "object",
        "properties": {
          "typing": {
            "type": "boolean"
          }
        }
      },
      "ChatPresenceResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ONLINE", "OFFLINE"]
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChatStateResponse": {
        "type": "object",
        "properties": {
          "partnerTyping": {
            "type": "boolean"
          },
          "partnerPresence": {
            "$ref": "#/components/schemas/ChatPresenceResponse"
          }
        }
      },
      "ChatReadRequest": {
        "type": "object",
        "properties": {
          "upToMessageId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["upToMessageId"]
      },
      "ChatSendMessageRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["TEXT", "EMOJI", "GIF", "MEDIA"]
          },
          "body": {
            "type": "string"
          },
          "gifUrl": {
            "type": "string"
          },
          "gifProviderId": {
            "type": "string"
          },
          "replyToMessageId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["type"]
      },
      "ChatAttachmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["IMAGE", "VIDEO"]
          },
          "url": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "senderUserId": {
            "type": "string",
            "format": "uuid"
          },
          "viewerMessage": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": ["TEXT", "EMOJI", "GIF", "MEDIA", "BUB", "SAFE_NOTICE"]
          },
          "body": {
            "type": "string"
          },
          "gifUrl": {
            "type": "string"
          },
          "gifProviderId": {
            "type": "string"
          },
          "reply": {
            "$ref": "#/components/schemas/ChatReplyPreviewResponse"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "editedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedForEveryone": {
            "type": "boolean"
          },
          "deliveryState": {
            "type": "string",
            "enum": ["DELIVERED", "SEEN"]
          },
          "editable": {
            "type": "boolean"
          },
          "deletableForEveryone": {
            "type": "boolean"
          },
          "viewerReaction": {
            "type": "string"
          },
          "reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatReactionSummaryResponse"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatAttachmentResponse"
            }
          },
          "safeItemCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChatReactionSummaryResponse": {
        "type": "object",
        "properties": {
          "reaction": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
