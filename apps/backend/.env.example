# Backend runtime configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Optional JWT issuer URI for Spring resource-server style JWT validation.
# Leave this as a local/dev issuer or replace it with your production issuer.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/app

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_RATE_LIMIT_AUTH_ENABLED=true
APP_RATE_LIMIT_AUTH_CAPACITY=60
APP_RATE_LIMIT_AUTH_REFILL_PERIOD=1m
APP_MULTIPART_MAX_FILE_SIZE=25MB
APP_MULTIPART_MAX_REQUEST_SIZE=100MB

# Supabase Storage for moment photo uploads. Keep SUPABASE_SECRET_KEY backend-only.
# SUPABASE_URL can be the project URL or the Storage S3 endpoint from the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-service-role-or-secret-key
SUPABASE_MOMENTS_BUCKET=moments
SUPABASE_CHAT_BUCKET=chat
SUPABASE_SAFE_BUCKET=safe
